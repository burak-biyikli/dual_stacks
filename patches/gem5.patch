+    auto stackStore = classifyStackAccess(true, false, true, rbp, rsp, rbp, "mov");
+    EXPECT_TRUE(stackStore.isStackBase);
+    EXPECT_FALSE(stackStore.isPush);
+
+    auto nonStack = classifyStackAccess(true, true, false, rax, rsp, rbp, "mov");
+    EXPECT_FALSE(nonStack.isStackBase);
+
+    auto disabled = classifyStackAccess(false, true, false, rsp, rsp, rbp, "pop");
