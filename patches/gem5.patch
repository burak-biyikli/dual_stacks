+from m5.params import *
+from m5.proxy import *
+from m5.SimObject import *
+
+class ValuePredType(ScopedEnum):
+    vals = ["MemoryRenaming"]
+
+class ValuePredictor(SimObject):
+    type = "ValuePredictor"
+    cxx_class = "gem5::valuepred::VPUnit"
+    cxx_header = "cpu/valuepred/valuepred_unit.hh"
+    abstract = True
+    numThreads = Param.Unsigned(Parent.numThreads, "Number of threads")
+
+class MemoryRenaming(ValuePredictor):
+    type = "MemoryRenaming"
+    cxx_class = "gem5::valuepred::MemoryRenaming"
+    cxx_header = "cpu/valuepred/memory_renaming.hh"
+    abstract = False
+
+    # Configurable MRP structure sizes
+    ways = Param.Int(4, "ways of the store-load cache / MRP")
+    tagWidth = Param.Int(16, "tag-width")
+    logESTBEntrys = Param.Int(10, "log 2 of store-load cache / MRP sets (10 -> 1024 sets)")
+    logMaxConfidence = Param.Int(2, "log 2 of max confidence number (2 -> 0..3)")
+    predictionThreshold = Param.Int(3, "threshold of confidence to enable prediction")
+    allocationConfidence = Param.Int(1, "starting confidence when a new MRP entry is allocated")
+    reallocationConfidence = Param.Int(1, "starting confidence when a load changes its producer store PC")
+    demotionPenalty = Param.Int(1, "Demotion penalty for wrong prediction or missing store")
+    mrtQueueCapacity = Param.Int(8, "Capacity of each circular queue in the MRT")
+    committedStoreQueueCapacity = Param.Int(512, "Depth of the retired store FIFO (RS-FIFO) used for commit-time overlap detection")
+
+    # Path enables
+    enableDynamic = Param.Bool(True, "Enable dynamic Memory Renaming path (MRP)")
+    enableStatic = Param.Bool(True, "Enable static Memory Renaming path (SRP)")
diff --git a/src/cpu/valuepred/memory_renaming.cc b/src/cpu/valuepred/memory_renaming.cc
new file mode 100644
index 0000000000..1f93afcf54
--- /dev/null
+++ b/src/cpu/valuepred/memory_renaming.cc
@@ -0,0 +1,272 @@
+#include "cpu/valuepred/memory_renaming.hh"
+
+#include <algorithm>
+
+#include "arch/x86/insts/microldstop.hh"
+#include "cpu/o3/cpu.hh"
+#include "cpu/o3/dyn_inst.hh"
+#include "debug/MemoryRenaming.hh"
+#include "base/logging.hh"
+
+namespace gem5
+{
+
+namespace valuepred
+{
+
+MemoryRenaming::MemoryRenaming(const Params &params)
+    : VPUnit(params),
+      core(params.ways, 1 << params.logESTBEntrys, params.tagWidth, params.logESTBEntrys,
+           params.logMaxConfidence, params.predictionThreshold,
+           params.allocationConfidence, params.reallocationConfidence,
+           params.demotionPenalty, params.mrtQueueCapacity,
+           params.committedStoreQueueCapacity, params.enableDynamic,
+           params.enableStatic, params.numThreads)
+{
+    uint64_t maxThreshold = (1ULL << params.logMaxConfidence) - 1;
+    fatal_if(params.predictionThreshold > maxThreshold,
+             "MemoryRenaming: predictionThreshold (%d) exceeds the maximum allowed limit (%d) defined by logMaxConfidence (%d).",
+             params.predictionThreshold, maxThreshold, params.logMaxConfidence);
+    fatal_if(params.predictionThreshold < 0,
+             "MemoryRenaming: predictionThreshold (%d) cannot be negative.", 
+             params.predictionThreshold);
+    fatal_if(params.allocationConfidence < 0 ||
+             params.allocationConfidence > maxThreshold,
+             "MemoryRenaming: allocationConfidence (%d) must be in [0, %d].",
+             params.allocationConfidence, maxThreshold);
+    fatal_if(params.reallocationConfidence < 0 ||
+             params.reallocationConfidence > maxThreshold,
+             "MemoryRenaming: reallocationConfidence (%d) must be in [0, %d].",
+             params.reallocationConfidence, maxThreshold);
+}
+
+VPPredictionCandidate
+MemoryRenaming::predict(const VPPredictRequest &request)
+{
+    VPPredictionCandidate candidate;
+    candidate.result.speculative = false;
+    candidate.result.value = 0;
+    return candidate;
+}
+
+void
+MemoryRenaming::renameStore(const gem5::o3::DynInstPtr &inst, PhysRegIdPtr st_physreg)
+{
+    Addr storePC = inst->pcState().instAddr();
+    ThreadID tid = inst->threadNumber;
+
+    // Retrieve store access size
+    auto *ldst = dynamic_cast<const X86ISA::LdStOp *>(inst->staticInst.get());
+    auto *ldstFp = dynamic_cast<const X86ISA::LdStFpOp *>(inst->staticInst.get());
+    uint8_t size = ldst ? ldst->dataSize : (ldstFp ? ldstFp->dataSize : 0);
+
+    bool stPhysRegReady = false;
+    Addr regVal = 0;
+    if (cpu && st_physreg && !st_physreg->is(InvalidRegClass)) {
+        stPhysRegReady = cpu->getScoreboard()->getReg(st_physreg);
+        if (stPhysRegReady) {
+            regVal = cpu->getReg(st_physreg, tid);
+        }
+    }
+
+    core.insertStore(storePC, inst->seqNum, tid, size, st_physreg, stPhysRegReady, regVal);
+
+    if (stPhysRegReady && st_physreg && !st_physreg->is(InvalidRegClass)) {
+        DPRINTF(MemoryRenaming, "Rename ST [sn:%lu] PC %lx: st_physreg %s ready immediately with data %lx\n",
+                inst->seqNum, storePC, st_physreg->className(), regVal);
+    } else {
+        DPRINTF(MemoryRenaming, "Rename ST [sn:%lu] PC %lx: st_physreg %s pending\n",
+                inst->seqNum, storePC, st_physreg ? st_physreg->className() : "null");
+    }
+
+    // SRP Stack Tracking for Pushes/Calls
+    if (core.enableStatic) {
+        RegIndex baseReg = ldst ? ldst->base : (ldstFp ? ldstFp->base : X86ISA::int_reg::NumArchRegs);
+        std::string macroMnem;
+        if (inst->macroop) {
+            macroMnem = inst->macroop->getName();
+        }
+        auto stackInfo = classifyStackAccess(
+            core.enableStatic, false, true, baseReg,
+            X86ISA::int_reg::_RspIdx, X86ISA::int_reg::_RbpIdx, macroMnem);
+        if (stackInfo.isStackBase) {
+            int64_t disp = ldst ? ldst->disp : (ldstFp ? ldstFp->disp : 0);
+            core.pushSRP(tid, storePC, inst->seqNum, size, disp, st_physreg);
+            DPRINTF(MemoryRenaming, "Rename SRP-Push [sn:%lu] PC %lx type:%s offset:%ld\n",
+                    inst->seqNum, storePC, stackInfo.isPush ? "Push" : "Store", disp);
+        }
+    }
+}
+
+void
+MemoryRenaming::renameLoad(const gem5::o3::DynInstPtr &inst, PhysRegIdPtr ld_physreg)
+{
+    Addr loadPC = inst->pcState().instAddr();
+    ThreadID tid = inst->threadNumber;
+
+    inst->vpResult.speculative = false;
+    inst->vpSupported = true;
+
+    auto *ldst = dynamic_cast<const X86ISA::LdStOp *>(inst->staticInst.get());
+    auto *ldstFp = dynamic_cast<const X86ISA::LdStFpOp *>(inst->staticInst.get());
+    uint8_t loadSize = ldst ? ldst->dataSize : (ldstFp ? ldstFp->dataSize : 0);
+    RegIndex baseReg = ldst ? ldst->base : (ldstFp ? ldstFp->base : X86ISA::int_reg::NumArchRegs);
+    int64_t disp = ldst ? ldst->disp : (ldstFp ? ldstFp->disp : 0);
+
+    bool isPop = false;
+    bool isPeek = false;
+    std::string macroMnem;
+    if (inst->macroop) {
+        macroMnem = inst->macroop->getName();
+    }
+    auto stackInfo = classifyStackAccess(
+        core.enableStatic, true, false, baseReg,
+        X86ISA::int_reg::_RspIdx, X86ISA::int_reg::_RbpIdx, macroMnem);
+    isPop = stackInfo.isPop;
+    isPeek = stackInfo.isPeek;
+
+    bool speculative = false;
+    Addr predictedVal = 0;
+    PhysRegIdPtr stPhysReg = nullptr;
+    bool dataReady = false;
+
+    stats.VPsupported++;
+
+    bool hit = core.matchLoad(loadPC, loadSize, tid, inst->seqNum, isPop, isPeek, disp,
+                              speculative, predictedVal, stPhysReg, dataReady);
+
+    if (hit) {
+        inst->vpResult.speculative = true;
+        stats.VPpredicted++;
+        if (dataReady) {
+            inst->vpResult.value = predictedVal;
+            if (cpu && ld_physreg && !ld_physreg->is(InvalidRegClass)) {
+                cpu->setReg(ld_physreg, predictedVal, tid);
+                cpu->getScoreboard()->setReg(ld_physreg);
+            }
+            DPRINTF(MemoryRenaming, "Rename LD [sn:%lu] PC %lx Match: data %lx injected into %s\n",
+                    inst->seqNum, loadPC, predictedVal, ld_physreg ? ld_physreg->className() : "null");
+        } else {
+            pendingLoads[stPhysReg->flatIndex()].push_back(inst);
+            DPRINTF(MemoryRenaming, "Rename LD [sn:%lu] PC %lx Match: Pending on st_physreg %s\n",
+                    inst->seqNum, loadPC, stPhysReg ? stPhysReg->className() : "null");
+        }
+    }
+}
+
+void
+MemoryRenaming::commitStore(Addr pc, InstSeqNum seqNum, Addr physAddr, uint8_t size)
+{
+    core.commitStore(pc, seqNum, physAddr, size);
+}
+
+void
+MemoryRenaming::update(const VPUpdateInfo &updateInfo,
+                      const VPPredictionRecord *record,
+                      const VPFeedback &feedback)
+{
+    Addr loadPC = updateInfo.pc;
+
+    if (auto *producerInfo = updateInfo.getExt<ProducerInfoExt>()) {
+        Addr storePC = producerInfo->producerStorePC;
+        InstSeqNum storeSeqNum = producerInfo->producerStoreSeqNum;
+
+        int offset = core.getProducerOffset(storeSeqNum, storePC);
+
+        if (offset >= 0) {
+            core.trainMRP(loadPC, storePC, offset, true);
+        } else {
+            core.trainMRP(loadPC, 0, 0, false);
+        }
+    } else {
+        auto match = core.findForwardingStore(updateInfo.physAddr,
+                                              updateInfo.accessSize,
+                                              updateInfo.seqNo);
+        if (match.found) {
+            int offset = core.getProducerOffset(match.storeSeqNum, match.storePC);
+            if (offset >= 0) {
+                core.trainMRP(loadPC, match.storePC, offset, true);
+            } else {
+                core.trainMRP(loadPC, 0, 0, false);
+            }
+        } else {
+            core.trainMRP(loadPC, 0, 0, false);
+        }
+    }
+
+    core.retireSRP(updateInfo.tid, updateInfo.seqNo);
+}
+
+void
+MemoryRenaming::specUpdate(const VPSpecUpdateInfo &specUpdateInfo)
+{
+}
+
+void
+MemoryRenaming::squash(ThreadID tid, const uint64_t seq_no)
+{
+    // Squash the core model state
+    core.squash(tid, seq_no);
+
+    // Squash pending loads mapping
+    for (auto &pair : pendingLoads) {
+        auto &list = pair.second;
+        list.erase(
+            std::remove_if(list.begin(), list.end(),
+                           [seq_no](const gem5::o3::DynInstPtr &inst) { return inst->seqNum > seq_no; }),
+            list.end());
+    }
+}
+
+void
+MemoryRenaming::writebackReg(PhysRegIdPtr physReg, RegVal val)
+{
+    if (!physReg || physReg->is(InvalidRegClass)) {
+        return;
+    }
+
+    core.updateMRTData(physReg, val);
+
+    RegIndex regIdx = physReg->flatIndex();
+    auto it = pendingLoads.find(regIdx);
+    if (it != pendingLoads.end()) {
+        auto &loads = it->second;
+        for (auto &loadInst : loads) {
+            if (!loadInst->isSquashed()) {
+                loadInst->vpResult.value = val;
+                loadInst->vpResult.speculative = true;
+                PhysRegIdPtr ld_physreg = loadInst->renamedDestIdx(0);
+                if (cpu && ld_physreg && !ld_physreg->is(InvalidRegClass)) {
+                    cpu->setReg(ld_physreg, val, loadInst->threadNumber);
+                    cpu->getScoreboard()->setReg(ld_physreg);
+                }
+                DPRINTF(MemoryRenaming, "Pending Writeback: injected st_physreg %s val %lx into LD [sn:%lu] ld_physreg %s\n",
+                        physReg->className(), val, loadInst->seqNum, ld_physreg ? ld_physreg->className() : "null");
+            }
+        }
+        pendingLoads.erase(it);
+    }
+}
+
+void
+MemoryRenaming::completeLoadLSU(const gem5::o3::DynInstPtr &inst)
+{
+    DPRINTF(MemoryRenaming, "completeLoadLSU: attempting to remove LD [sn:%lu] PC %lx\n",
+            inst->seqNum, inst->pcState().instAddr());
+    for (auto &pair : pendingLoads) {
+        auto &list = pair.second;
+        auto initial_size = list.size();
+        list.erase(
+            std::remove_if(list.begin(), list.end(),
+                           [&inst](const gem5::o3::DynInstPtr &pInst) { return pInst->seqNum == inst->seqNum; }),
+            list.end());
+        if (list.size() < initial_size) {
+            DPRINTF(MemoryRenaming, "completeLoadLSU: removed LD [sn:%lu] from pendingLoads flatIndex %d\n",
+                    inst->seqNum, pair.first);
+        }
+    }
+}
+
+} // namespace valuepred
+
+} // namespace gem5
