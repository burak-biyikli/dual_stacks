+#ifndef __CPU_VALUEPRED_MEMORY_RENAMING_HH__
+#define __CPU_VALUEPRED_MEMORY_RENAMING_HH__
+
+#include <cstdint>
+#include <list>
+#include <unordered_map>
+#include <vector>
+
+#include "base/types.hh"
+#include "cpu/inst_seq.hh"
+#include "cpu/o3/dyn_inst_ptr.hh"
+#include "cpu/reg_class.hh"
+#include "cpu/valuepred/memory_renaming_core.hh"
+#include "cpu/valuepred/valuepred_unit.hh"
+#include "params/MemoryRenaming.hh"
+
+namespace gem5
+{
+
+namespace o3
+{
+class CPU;
+}
+
+namespace valuepred
+{
+
+class MemoryRenaming : public VPUnit
+{
+  public:
+    using Params = MemoryRenamingParams;
+
+  private:
+    // CPU pointer
+    gem5::o3::CPU* cpu = nullptr;
+
+    // Core Business Logic Engine
+    MemoryRenamingCore<PhysRegIdPtr> core;
+
+    // Pending Load Queue (gem5 pipeline-specific mapping: st_physreg flat index -> pending loads)
+    std::unordered_map<RegIndex, std::vector<gem5::o3::DynInstPtr>> pendingLoads;
+
+  public:
+    MemoryRenaming(const Params &params);
+    ~MemoryRenaming() = default;
+
+    std::string name() const override { return "MemoryRenaming"; }
+
+    void setCPU(gem5::o3::CPU* _cpu) { cpu = _cpu; }
+
+    // VPUnit standard interfaces
+    VPPredictionCandidate predict(const VPPredictRequest &request) override;
+    void update(const VPUpdateInfo &updateInfo, const VPPredictionRecord *record,
+                const VPFeedback &feedback) override;
+    void specUpdate(const VPSpecUpdateInfo &specUpdateInfo) override;
+    void squash(ThreadID tid, const uint64_t seq_no) override;
+    void writebackReg(PhysRegIdPtr physReg, RegVal val) override;
+    ValuePredType getValuePredictorType() override { return ValuePredType::MemoryRenaming; }
+
+    // Rename-stage custom hooks
+    void renameStore(const gem5::o3::DynInstPtr &inst, PhysRegIdPtr st_physreg);
+    void renameLoad(const gem5::o3::DynInstPtr &inst, PhysRegIdPtr ld_physreg);
+
+    // Commit-stage custom hooks
+    void commitStore(Addr pc, InstSeqNum seqNum, Addr physAddr = 0, uint8_t size = 0);
+
+    // LSQ completion hook
+    void completeLoadLSU(const gem5::o3::DynInstPtr &inst);
+};
+
+} // namespace valuepred
+
+} // namespace gem5
+
+#endif // __CPU_VALUEPRED_MEMORY_RENAMING_HH__
diff --git a/src/cpu/valuepred/memory_renaming.test.cc b/src/cpu/valuepred/memory_renaming.test.cc
new file mode 100644
index 0000000000..ba9fa89c8a
--- /dev/null
+++ b/src/cpu/valuepred/memory_renaming.test.cc
@@ -0,0 +1,716 @@
+#include <gtest/gtest.h>
+#include <random>
+#include <vector>
+
+#include "cpu/valuepred/memory_renaming_core.hh"
+
+using namespace gem5;
+using namespace gem5::valuepred;
+
+class MemoryRenamingCoreTest : public ::testing::Test
+{
+  protected:
+    // Helper to create a core with default settings
+    MemoryRenamingCore<int> *createDefaultCore()
+    {
+        return new MemoryRenamingCore<int>(
+            4,      // ways
+            1024,   // entryCounts (log2=10)
+            16,     // tagWidth
+            10,     // logESTBEntrys
+            2,      // logMaxConfidence (max=3)
+            2,      // confidenceThreshold
+            1,      // allocationConfidence
+            1,      // reallocationConfidence
+            1,      // demotionPenalty
+            8,      // mrtQueueCapacity
+            512,    // committedStoreQueueCapacity
+            true,   // enableDynamic
+            true,   // enableStatic
+            1       // numThreads
+        );
+    }
+};
+
+// ============================================================================
+// 1. MRP Confidence & Freezing Tests
+// ============================================================================
+
+TEST_F(MemoryRenamingCoreTest, MRPConfidenceAndFreezing)
+{
+    auto core = createDefaultCore();
+
+    Addr loadPC = 0x1000;
+    Addr storePC = 0x2000;
+    int offset = 0;
+
+    // Initially, there should be no valid prediction for this loadPC
+    bool outFrozen = false;
+    bool hit = core->lookupMRP(loadPC, outFrozen);
+    EXPECT_FALSE(hit);
+    EXPECT_FALSE(outFrozen);
+
+    // Train successfully first time (Allocation)
+    core->trainMRP(loadPC, storePC, offset, true);
+
+    // After first train, we hit but confidence is 1, which is below the threshold of 2
+    // So lookupMRP should return hit = false or not active prediction
+    hit = core->lookupMRP(loadPC, outFrozen);
+    // Note: lookupMRP only checks if the entry is frozen. Let's inspect the tables directly.
+    int way = -1;
+    for (int i = 0; i < core->ways; i++) {
+        uint32_t idx = core->pcHashToWayIndex(loadPC, i);
+        uint32_t tag = core->pcHashToTag(loadPC, i);
+        if (core->mrpTable[i][idx].valid && core->compareTags(core->mrpTable[i][idx].tag, tag) == 0) {
+            way = i;
+            break;
+        }
+    }
+    ASSERT_GE(way, 0);
+    auto &entry = core->mrpTable[way][core->pcHashToWayIndex(loadPC, way)];
+    EXPECT_EQ(entry.storePC, storePC);
+    EXPECT_EQ(entry.confidence, 1);
+    EXPECT_FALSE(entry.frozen);
+
+    // Train successfully again (Confidence Promotion)
+    core->trainMRP(loadPC, storePC, offset, true);
+    EXPECT_EQ(entry.confidence, 2);
+    EXPECT_FALSE(entry.frozen);
+
+    // Saturate confidence
+    core->trainMRP(loadPC, storePC, offset, true);
+    EXPECT_EQ(entry.confidence, 3);
+    core->trainMRP(loadPC, storePC, offset, true);
+    EXPECT_EQ(entry.confidence, 3); // Saturates at 3
+
+    // Demote once
+    core->trainMRP(loadPC, storePC, offset, false);
+    EXPECT_EQ(entry.confidence, 2);
+    EXPECT_FALSE(entry.frozen);
+
+    // Demote below threshold (threshold is 2, so dropping to 1 freezes it)
+    core->trainMRP(loadPC, storePC, offset, false);
+    EXPECT_EQ(entry.confidence, 1);
+    EXPECT_TRUE(entry.frozen);
+
+    // Once frozen, successful updates cannot unfreeze or increment confidence
+    core->trainMRP(loadPC, storePC, offset, true);
+    EXPECT_TRUE(entry.frozen);
+    EXPECT_EQ(entry.confidence, 1);
+
+    // Re-training with a different store PC resets the entry and unfreezes it
+    Addr newStorePC = 0x3000;
+    core->trainMRP(loadPC, newStorePC, offset, true);
+    EXPECT_FALSE(entry.frozen);
+    EXPECT_EQ(entry.storePC, newStorePC);
+    EXPECT_EQ(entry.confidence, 1);
+
+    delete core;
+}
+
+TEST_F(MemoryRenamingCoreTest, MRPReallocationConfidenceFreezesOnPCChange)
+{
+    auto core = new MemoryRenamingCore<int>(
+        4, 1024, 16, 10, 2, 2, 1, 0, 1, 8, 512, true, true, 1);
+
+    Addr loadPC = 0x1000;
+    Addr storePC1 = 0x2000;
+    Addr storePC2 = 0x3000;
+    int offset = 0;
+
+    core->trainMRP(loadPC, storePC1, offset, true);
+    core->trainMRP(loadPC, storePC1, offset, true);
+    core->trainMRP(loadPC, storePC2, offset, true);
+
+    int way = -1;
+    for (int i = 0; i < core->ways; i++) {
+        uint32_t idx = core->pcHashToWayIndex(loadPC, i);
+        uint32_t tag = core->pcHashToTag(loadPC, i);
+        auto &entry = core->mrpTable[i][idx];
+        if (entry.valid && core->compareTags(entry.tag, tag) == 0) {
+            way = i;
+            EXPECT_EQ(entry.storePC, storePC2);
+            EXPECT_EQ(entry.confidence, 0);
+            EXPECT_TRUE(entry.frozen);
+            break;
+        }
+    }
+    EXPECT_NE(way, -1);
+
+    bool outFrozen = false;
+    EXPECT_TRUE(core->lookupMRP(loadPC, outFrozen));
+    EXPECT_TRUE(outFrozen);
+
+    delete core;
+}
+
+TEST_F(MemoryRenamingCoreTest, MRPConfidenceTuneableDemotionAndClamping)
+{
+    // Create core with demotionPenalty = 3, threshold = 1, max confidence = 7 (logMaxConfidence = 3)
+    auto core = new MemoryRenamingCore<int>(
+        4,      // ways
+        1024,   // entryCounts
+        16,     // tagWidth
+        10,     // logESTBEntrys
+        3,      // logMaxConfidence (max = 7)
+        1,      // confidenceThreshold
+        1,      // allocationConfidence
+        1,      // reallocationConfidence
+        3,      // demotionPenalty
+        8,      // mrtQueueCapacity
+        512,    // committedStoreQueueCapacity
+        true,   // enableDynamic
+        true,   // enableStatic
+        1       // numThreads
+    );
+
+    Addr loadPC = 0x1000;
+    Addr storePC = 0x2000;
+    int offset = 0;
+
+    // Train to saturate confidence (starts at 1 -> 2 -> 3 -> 4 -> 5 -> 6 -> 7)
+    for (int i = 0; i < 10; i++) {
+        core->trainMRP(loadPC, storePC, offset, true);
+    }
+
+    // Inspect directly
+    int way = -1;
+    for (int w = 0; w < core->ways; w++) {
+        uint32_t idx = core->pcHashToWayIndex(loadPC, w);
+        uint32_t tag = core->pcHashToTag(loadPC, w);
+        if (core->mrpTable[w][idx].valid && core->compareTags(core->mrpTable[w][idx].tag, tag) == 0) {
+            way = w;
+            break;
+        }
+    }
+    ASSERT_GE(way, 0);
+    auto &entry = core->mrpTable[way][core->pcHashToWayIndex(loadPC, way)];
+    EXPECT_EQ(entry.confidence, 7);
+    EXPECT_FALSE(entry.frozen);
+
+    // Demote once: confidence drops from 7 to 4 (demotion penalty is 3)
+    core->trainMRP(loadPC, storePC, offset, false);
+    EXPECT_EQ(entry.confidence, 4);
+    EXPECT_FALSE(entry.frozen);
+
+    // Demote again: confidence drops from 4 to 1. Since 1 >= threshold (1), it is not frozen yet.
+    core->trainMRP(loadPC, storePC, offset, false);
+    EXPECT_EQ(entry.confidence, 1);
+    EXPECT_FALSE(entry.frozen);
+
+    // Demote again: confidence drops by 3. Since 1 - 3 < 0, it must clamp to 0.
+    // Since 0 < threshold (1), it freezes at 0.
+    core->trainMRP(loadPC, storePC, offset, false);
+    EXPECT_EQ(entry.confidence, 0);
+    EXPECT_TRUE(entry.frozen);
+
+
+    // Attempt hit on frozen entry with confidence 0: confidence must not increase.
+    core->trainMRP(loadPC, storePC, offset, true);
+    EXPECT_EQ(entry.confidence, 0);
+    EXPECT_TRUE(entry.frozen);
+
+    delete core;
+}
