+// ============================================================================
+// 2. MRP Replacement Policy (2-bit RRIP) Tests
+// ============================================================================
+
+TEST_F(MemoryRenamingCoreTest, MRPRRIPReplacementDeterministic)
+{
+    // Create a core with 1 set (logESTBEntrys=0) so that all PCs map to set index 0.
+    auto core = new MemoryRenamingCore<int>(
+        4,      // ways
+        1,      // entryCounts (log2=0)
+        16,     // tagWidth
+        0,      // logESTBEntrys
+        2,      // logMaxConfidence
+        2,      // confidenceThreshold
+        1,      // allocationConfidence
+        1,      // reallocationConfidence
+        1,      // demotionPenalty
+        8,      // mrtQueueCapacity
+        512,    // committedStoreQueueCapacity
+        true,   // enableDynamic
+        true,   // enableStatic
+        1       // numThreads
+    );
+
+    std::vector<Addr> matchingPCs = { 0x1000, 0x2000, 0x3000, 0x4000, 0x5000 };
+
+    // Train the first 4 PCs (fill all 4 ways of set 0)
+    for (int i = 0; i < 4; i++) {
+        core->trainMRP(matchingPCs[i], 0x2000 + i, 0, true);
+    }
+
+    // Verify all 4 ways of set 0 are valid and have initial RRIP = 2
+    for (int w = 0; w < 4; w++) {
+        auto &entry = core->mrpTable[w][0];
+        EXPECT_TRUE(entry.valid);
+        EXPECT_EQ(entry.rrip, 2);
+    }
+
+    // Lookup matchingPCs[0] to hit and reset its RRIP to 0
+    bool outFrozen = false;
+    core->lookupMRP(matchingPCs[0], outFrozen);
+    // Since lookupMRP resets RRIP on hit, matchingPCs[0]'s way should now have RRIP = 0.
+    // Let's find which way matchingPCs[0] is in.
+    int way0 = -1;
+    for (int w = 0; w < 4; w++) {
+        uint32_t tag = core->pcHashToTag(matchingPCs[0], w);
+        if (core->compareTags(core->mrpTable[w][0].tag, tag) == 0) {
+            way0 = w;
+            break;
+        }
+    }
+    ASSERT_GE(way0, 0);
+    EXPECT_EQ(core->mrpTable[way0][0].rrip, 0);
+
+    // Train matchingPCs[1] again to reset its RRIP to 0 as well
+    core->trainMRP(matchingPCs[1], 0x2001, 0, true);
+    int way1 = -1;
+    for (int w = 0; w < 4; w++) {
+        uint32_t tag = core->pcHashToTag(matchingPCs[1], w);
+        if (core->compareTags(core->mrpTable[w][0].tag, tag) == 0) {
+            way1 = w;
+            break;
+        }
+    }
+    ASSERT_GE(way1, 0);
+    EXPECT_EQ(core->mrpTable[way1][0].rrip, 0);
+
+    // Current state of RRIPs:
+    // way0: 0, way1: 0, other two ways: 2
+    // Now insert matchingPCs[4] (the 5th PC)
+    // This will evict one of the entries with RRIP = 2 (not RRIP = 0).
+    core->trainMRP(matchingPCs[4], 0x9000, 0, true);
+
+    // Check that either matchingPCs[2] or matchingPCs[3] was evicted, and NOT matchingPCs[0] or matchingPCs[1]
+    bool pc0Present = false;
+    bool pc1Present = false;
+    bool pc4Present = false;
+    for (int w = 0; w < 4; w++) {
+        auto &entry = core->mrpTable[w][0];
+        uint32_t tag0 = core->pcHashToTag(matchingPCs[0], w);
+        uint32_t tag1 = core->pcHashToTag(matchingPCs[1], w);
+        uint32_t tag4 = core->pcHashToTag(matchingPCs[4], w);
+        if (core->compareTags(entry.tag, tag0) == 0) pc0Present = true;
+        if (core->compareTags(entry.tag, tag1) == 0) pc1Present = true;
+        if (core->compareTags(entry.tag, tag4) == 0) pc4Present = true;
+    }
+    EXPECT_TRUE(pc0Present);
+    EXPECT_TRUE(pc1Present);
+    EXPECT_TRUE(pc4Present);
+
+    delete core;
+}
+
+// Helper to run RRIP replacement fuzzer on arbitrary way configurations
+static void runRRIPFuzzer(int ways, int iterations)
+{
+    // Create a core with 1 set (logESTBEntrys=0) so that all PCs map to set index 0.
+    auto core = new MemoryRenamingCore<int>(
+        ways,   // ways
+        1,      // entryCounts (log2=0)
+        16,     // tagWidth
+        0,      // logESTBEntrys
+        2,      // logMaxConfidence
+        2,      // confidenceThreshold
+        1,      // allocationConfidence
+        1,      // reallocationConfidence
+        1,      // demotionPenalty
+        8,      // mrtQueueCapacity
+        512,    // committedStoreQueueCapacity
+        true,   // enableDynamic
+        true,   // enableStatic
+        1       // numThreads
+    );
+
+    // Populate matching PCs for all ways
+    std::vector<Addr> matchingPCs;
+    for (int i = 0; i < ways; i++) {
+        matchingPCs.push_back(0x1000 * (i + 1));
+    }
+
+    // Fill the set
+    for (int i = 0; i < ways; i++) {
+        core->trainMRP(matchingPCs[i], 0x2000 + i, 0, true);
+    }
+
+    std::mt19937 gen(42 + ways);
+    std::uniform_int_distribution<Addr> randPC(10000, 1000000);
+
+    for (int iter = 0; iter < iterations; iter++) {
+        // Access target PC (matchingPCs[0]) to keep its RRIP at 0
+        bool outFrozen = false;
+        core->lookupMRP(matchingPCs[0], outFrozen);
+
+        // Access a random PC (guaranteed to map to set 0 since entryCounts=1)
+        Addr evictingPC = randPC(gen);
+        // Make sure it doesn't match the target PC tag to avoid hitting target RRIP
+        while (evictingPC == matchingPCs[0]) {
+            evictingPC = randPC(gen);
+        }
+
+        // Train with the evicting PC to cause eviction in set 0
+        core->trainMRP(evictingPC, 0x5000, 0, true);
+
+        // Verify target PC is still present in set 0
+        bool targetPresent = false;
+        for (int w = 0; w < ways; w++) {
+            auto &entry = core->mrpTable[w][0];
+            uint32_t tag = core->pcHashToTag(matchingPCs[0], w);
+            if (entry.valid && core->compareTags(entry.tag, tag) == 0) {
+                targetPresent = true;
+                break;
+            }
+        }
+        ASSERT_TRUE(targetPresent) << "Target PC got evicted at iteration " << iter << " for ways=" << ways;
+    }
+
+    delete core;
+}
+
+TEST_F(MemoryRenamingCoreTest, MRPRRIPReplacementFuzzer)
+{
+    // Test RRIP replacement fuzzer on different way configurations (4, 8, 16, 32)
+    // with 2000 iterations each.
+    runRRIPFuzzer(4, 2000);
+    runRRIPFuzzer(8, 2000);
+    runRRIPFuzzer(16, 2000);
+    runRRIPFuzzer(32, 2000);
+}
