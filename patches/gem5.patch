new file mode 100644
index 0000000000..a2d6b4921d
--- /dev/null
+++ b/src/cpu/valuepred/memory_renaming_core.hh
@@ -0,0 +1,622 @@
+#ifndef __CPU_VALUEPRED_MEMORY_RENAMING_CORE_HH__
+#define __CPU_VALUEPRED_MEMORY_RENAMING_CORE_HH__
+
+#include <algorithm>
+#include <cctype>
+#include <cstdint>
+#include <deque>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "base/types.hh"
+#include "cpu/inst_seq.hh"
+
+
+namespace gem5
+{
+
+namespace valuepred
+{
+
+struct MRPEntry
+{
+    uint32_t tag = 0;
+    Addr storePC = 0;
+    int offset = 0;
+    uint8_t confidence = 0;
+    bool valid = false;
+    bool frozen = false;
+    uint8_t rrip = 3;
+};
+
+template <typename RegIdType>
+struct MRTEntry
+{
+    Addr data = 0;
+    RegIdType st_physreg = {};
+    InstSeqNum seqNum = 0;
+    bool dataReady = false;
+    bool valid = false;
+    uint8_t size = 0;
+};
+
+template <typename RegIdType>
+struct MRTCircularQueue
+{
+    std::vector<MRTEntry<RegIdType>> buffer;
+    int head = 0;
+    int tail = 0;
+    int count = 0;
+    int capacity = 8;
+
+    MRTCircularQueue(int cap = 8) : buffer(cap), capacity(cap) {}
+
+    void push(const MRTEntry<RegIdType> &entry)
+    {
+        if (count == capacity) {
+            head = (head + 1) % capacity;
+            count--;
+        }
+        buffer[tail] = entry;
+        tail = (tail + 1) % capacity;
+        count++;
+    }
+
+    MRTEntry<RegIdType>* getAtOffset(int offset)
+    {
+        if (offset < 0 || offset >= count) return nullptr;
+        int idx = (tail - 1 - offset + capacity) % capacity;
+        return &buffer[idx];
+    }
+
+    void rollback(int numToPop)
+    {
+        if (numToPop <= 0) return;
+        if (numToPop > count) numToPop = count;
+        tail = (tail - numToPop + capacity) % capacity;
+        count -= numToPop;
+    }
+};
+
+struct ActiveStore
+{
+    Addr pc = 0;
+    InstSeqNum seqNum = 0;
+    ThreadID tid = 0;
+};
+
+template <typename RegIdType>
+struct SRPEntry
+{
+    Addr pushPC = 0;
+    RegIdType st_physreg = {};
+    InstSeqNum seqNum = 0;
+    uint8_t size = 0;
+    int64_t spOffset = 0;
+    bool popped = false;
+    InstSeqNum poppedSeqNum = 0;
+};
+
+struct CommittedStore
+{
+    Addr pc = 0;
+    InstSeqNum seqNum = 0;
+    Addr physAddr = 0;
+    uint8_t size = 0;
+};
+
+struct RSFIFOMatch
+{
+    bool found = false;
+    Addr storePC = 0;
+    InstSeqNum storeSeqNum = 0;
+};
+
+/** Result of decoding whether a memory uop targets the private stack. */
+struct StackAccessInfo
+{
+    bool isStackBase = false;
+    bool isPush = false;
+    bool isPop = false;
+    bool isPeek = false;
+};
+
+/**
+ * Classify stack-related memory operations from rename-stage metadata.
+ * rspIdx / rbpIdx are architecture-specific stack/frame pointer indices.
+ */
+inline StackAccessInfo
+classifyStackAccess(bool enableStatic, bool isLoad, bool isStore,
+                    int baseReg, int rspIdx, int rbpIdx,
+                    const std::string &macroMnemonic)
+{
+    StackAccessInfo info;
+    if (!enableStatic || (!isLoad && !isStore)) {
+        return info;
+    }
+    if (baseReg != rspIdx && baseReg != rbpIdx) {
+        return info;
+    }
+
+    info.isStackBase = true;
+    std::string mnem = macroMnemonic;
+    std::transform(mnem.begin(), mnem.end(), mnem.begin(),
+                   [](unsigned char c) { return std::tolower(c); });
+
+    if (isStore && (mnem == "push" || mnem == "call")) {
+        info.isPush = true;
+    } else if (isLoad && (mnem == "pop" || mnem == "ret")) {
+        info.isPop = true;
+    } else if (isLoad) {
+        info.isPeek = true;
+    }
+
+    return info;
+}
+
+template <typename RegIdType>
+class MemoryRenamingCore
+{
+  public:
+    // Configurable parameters
+    const int ways;
+    const int entryCounts;
+    const int tagWidth;
+    const int logESTBEntrys;
+    const int logMaxConfidence;
+    const int MAXCONFIDENCE;
+    const int confidenceThreshold;
+    const int allocationConfidence;
+    const int reallocationConfidence;
+    const int demotionPenalty;
+    const int mrtQueueCapacity;
+    const int committedStoreQueueCapacity;
+    const bool enableDynamic;
+    const bool enableStatic;
+
+    // Storage tables
+    std::vector<std::vector<MRPEntry>> mrpTable;
+    std::unordered_map<Addr, MRTCircularQueue<RegIdType>> mrtTable;
+    std::deque<ActiveStore> activeStoreList;
+    std::vector<std::deque<SRPEntry<RegIdType>>> srpStacks;
+    std::deque<CommittedStore> committedStoreQueue;
+
+    MemoryRenamingCore(int _ways, int _entryCounts, int _tagWidth, int _logESTBEntrys,
+                       int _logMaxConfidence, int _confidenceThreshold,
+                       int _allocationConfidence, int _reallocationConfidence,
+                       int _demotionPenalty, int _mrtQueueCapacity,
+                       int _committedStoreQueueCapacity, bool _enableDynamic,
+                       bool _enableStatic, int numThreads)
+        : ways(_ways), entryCounts(_entryCounts), tagWidth(_tagWidth), logESTBEntrys(_logESTBEntrys),
+          logMaxConfidence(_logMaxConfidence), MAXCONFIDENCE((1 << _logMaxConfidence) - 1),
+          confidenceThreshold(_confidenceThreshold),
+          allocationConfidence(_allocationConfidence),
+          reallocationConfidence(_reallocationConfidence),
+          demotionPenalty(_demotionPenalty),
+          mrtQueueCapacity(_mrtQueueCapacity),
+          committedStoreQueueCapacity(_committedStoreQueueCapacity),
+          enableDynamic(_enableDynamic), enableStatic(_enableStatic)
+    {
+        mrpTable.resize(ways);
+        for (auto &table : mrpTable) {
+            table.resize(entryCounts);
+        }
+        srpStacks.resize(numThreads);
+    }
+
+    uint32_t
+    pcHashToWayIndex(Addr pc, int way)
+    {
+        uint64_t hash = pc;
+        for (int k = 1; k <= ways; k++) {
+            int shift = ((k * logESTBEntrys) - way) % 64;
+            if (shift < 0) shift += 64;
+            hash ^= (pc >> shift);
+        }
+        return hash & (entryCounts - 1);
+    }
+
+    uint32_t
+    pcHashToTag(Addr pc, int way)
+    {
+        int j = ways - way;
+        if (j < 0) j = 0;
+        uint64_t hash = pc;
+        for (int k = 1; k <= ways + 1; k++) {
+            int shift = ((k * logESTBEntrys) - j) % 64;
+            if (shift < 0) shift += 64;
+            hash ^= (pc >> shift);
+        }
+        return hash & ((1 << tagWidth) - 1);
+    }
+
+    uint32_t
+    compareTags(uint32_t tag1, uint32_t tag2)
+    {
+        return ((tag1 & ((1 << tagWidth) - 1)) ^ (tag2 & ((1 << tagWidth) - 1)));
+    }
+
+    bool
+    lookupMRP(Addr loadPC, bool &outFrozen)
+    {
+        std::vector<uint32_t> indexEachWays(ways);
+        std::vector<uint32_t> tagEachWays(ways);
+        for (int i = 0; i < ways; i++) {
+            indexEachWays[i] = pcHashToWayIndex(loadPC, i);
+            tagEachWays[i] = pcHashToTag(loadPC, i);
+        }
+        for (int i = 0; i < ways; i++) {
+            auto &mrpEntry = mrpTable[i][indexEachWays[i]];
+            if (mrpEntry.valid && !compareTags(mrpEntry.tag, tagEachWays[i])) {
+                mrpEntry.rrip = 0; // Reset RRIP on hit
+                if (mrpEntry.frozen) {
+                    outFrozen = true;
+                    return true;
+                }
+            }
+        }
+        outFrozen = false;
+        return false;
+    }
+
+    void
+    trainMRP(Addr loadPC, Addr storePC, int offset, bool successful)
+    {
+        std::vector<uint32_t> indexEachWays(ways);
+        std::vector<uint32_t> tagEachWays(ways);
+        for (int i = 0; i < ways; i++) {
+            indexEachWays[i] = pcHashToWayIndex(loadPC, i);
+            tagEachWays[i] = pcHashToTag(loadPC, i);
+        }
+
+        int hitWay = -1;
+        for (int i = 0; i < ways; i++) {
+            auto &mrpEntry = mrpTable[i][indexEachWays[i]];
+            if (mrpEntry.valid && !compareTags(mrpEntry.tag, tagEachWays[i])) {
+                hitWay = i;
+                break;
+            }
+        }
+
+        if (hitWay >= 0) {
+            auto &mrpEntry = mrpTable[hitWay][indexEachWays[hitWay]];
+            mrpEntry.rrip = 0; // Reset RRIP to 0 on hit
+            if (successful) {
+                if (mrpEntry.storePC == storePC && mrpEntry.offset == offset) {
+                    if (!mrpEntry.frozen) {
+                        if (mrpEntry.confidence < MAXCONFIDENCE) {
+                            mrpEntry.confidence++;
+                        }
+                    }
+                } else {
+                    mrpEntry.storePC = storePC;
+                    mrpEntry.offset = offset;
+                    mrpEntry.confidence = reallocationConfidence;
+                    if (reallocationConfidence == allocationConfidence) {
+                        mrpEntry.frozen = false;
+                    } else {
+                        mrpEntry.frozen =
+                            reallocationConfidence < confidenceThreshold;
+                    }
+                }
+            } else {
+                if (!mrpEntry.frozen) {
+                    if (mrpEntry.confidence >= demotionPenalty) {
+                        mrpEntry.confidence -= demotionPenalty;
+                    } else {
+                        mrpEntry.confidence = 0;
+                    }
+                    if (mrpEntry.confidence < confidenceThreshold) {
+                        mrpEntry.frozen = true;
+                    }
+                }
+            }
+        } else if (successful) {
+            // Allocate a new entry using RRIP replacement
+            int victimWay = -1;
+            while (victimWay < 0) {
+                for (int i = 0; i < ways; i++) {
+                    auto &mrpEntry = mrpTable[i][indexEachWays[i]];
+                    if (!mrpEntry.valid || mrpEntry.rrip == 3) {
+                        victimWay = i;
+                        break;
+                    }
+                }
+                if (victimWay < 0) {
+                    for (int i = 0; i < ways; i++) {
+                        mrpTable[i][indexEachWays[i]].rrip++;
+                    }
+                }
+            }
+
+            auto &victim = mrpTable[victimWay][indexEachWays[victimWay]];
+            victim.valid = true;
+            victim.frozen = false;
+            victim.tag = tagEachWays[victimWay];
+            victim.storePC = storePC;
+            victim.offset = offset;
+            victim.confidence = allocationConfidence;
+            victim.rrip = 2; // Allocation RRIP
+        }
+    }
+
+    void
+    commitStore(Addr pc, InstSeqNum seqNum, Addr physAddr = 0, uint8_t size = 0)
+    {
+        CommittedStore entry;
+        entry.pc = pc;
+        entry.seqNum = seqNum;
+        entry.physAddr = physAddr;
+        entry.size = size;
+        committedStoreQueue.push_back(entry);
+        while ((int)committedStoreQueue.size() > committedStoreQueueCapacity) {
+            committedStoreQueue.pop_front();
+        }
+
+        // Reclaim retired stores from activeStoreList
+        while (!activeStoreList.empty() && activeStoreList.front().seqNum <= seqNum) {
+            activeStoreList.pop_front();
+        }
+    }
+
+    RSFIFOMatch
+    findForwardingStore(Addr loadPhysAddr, uint8_t loadSize, InstSeqNum loadSeqNum)
+    {
+        RSFIFOMatch match;
+        if (loadSize == 0) {
+            return match;
+        }
+        for (int i = (int)committedStoreQueue.size() - 1; i >= 0; i--) {
+            const auto &entry = committedStoreQueue[i];
+            if (entry.seqNum >= loadSeqNum) {
+                continue;
+            }
+            if (entry.size != loadSize) {
+                continue;
+            }
+            if (entry.physAddr != loadPhysAddr) {
+                continue;
+            }
+            match.found = true;
+            match.storePC = entry.pc;
+            match.storeSeqNum = entry.seqNum;
+            return match;
+        }
+        return match;
+    }
+
+    void
+    retireSRP(ThreadID tid, InstSeqNum committedSeqNum)
+    {
+        auto &stack = srpStacks[tid];
+        while (!stack.empty()) {
+            auto &front = stack.front();
+            if (front.popped && front.poppedSeqNum <= committedSeqNum) {
+                stack.pop_front();
+            } else {
+                break;
+            }
+        }
+    }
+
+    int
+    getProducerOffset(InstSeqNum producerStoreSeqNum, Addr storePC)
+    {
+        int offset = 0;
+        for (int i = (int)committedStoreQueue.size() - 1; i >= 0; i--) {
+            if (committedStoreQueue[i].seqNum == producerStoreSeqNum) {
+                return offset;
+            }
+            if (committedStoreQueue[i].pc == storePC) {
+                offset++;
+            }
+        }
+        return -1;
+    }
+
+    void
+    insertStore(Addr storePC, InstSeqNum seqNum, ThreadID tid, uint8_t size,
+                RegIdType st_physreg, bool stPhysRegReady, Addr regVal)
+    {
+        if (mrtTable.find(storePC) == mrtTable.end()) {
+            mrtTable.emplace(storePC, MRTCircularQueue<RegIdType>(mrtQueueCapacity));
+        }
+        auto &q = mrtTable[storePC];
+
+        MRTEntry<RegIdType> entry;
+        entry.data = regVal;
+        entry.st_physreg = st_physreg;
+        entry.seqNum = seqNum;
+        entry.dataReady = stPhysRegReady;
+        entry.valid = true;
+        entry.size = size;
+
+        q.push(entry);
+
+        ActiveStore activeStore;
+        activeStore.pc = storePC;
+        activeStore.seqNum = seqNum;
+        activeStore.tid = tid;
+        activeStoreList.push_back(activeStore);
+    }
+
+    void
+    pushSRP(ThreadID tid, Addr pushPC, InstSeqNum seqNum, uint8_t size, int64_t spOffset, RegIdType st_physreg)
+    {
+        SRPEntry<RegIdType> entry;
+        entry.pushPC = pushPC;
+        entry.st_physreg = st_physreg;
+        entry.seqNum = seqNum;
+        entry.size = size;
+        entry.spOffset = spOffset;
+        entry.popped = false;
+        entry.poppedSeqNum = 0;
+
+        auto &stack = srpStacks[tid];
+        stack.push_back(entry);
+        while (stack.size() > 256) {
+            stack.pop_front(); // Hard-limit bound to protect memory
+        }
+    }
+
+    bool
+    matchLoad(Addr loadPC, uint8_t loadSize, ThreadID tid, InstSeqNum seqNum,
+              bool isPop, bool isPeek, int64_t disp,
+              bool &outSpeculative, Addr &outData, RegIdType &outStPhysReg, bool &outDataReady)
+    {
+        outSpeculative = false;
+
+        // Try SRP-Stack match first
+        if (enableStatic && (isPop || isPeek)) {
+            auto &stack = srpStacks[tid];
+            int matchIdx = -1;
+            if (isPop) {
+                for (int i = (int)stack.size() - 1; i >= 0; i--) {
+                    if (!stack[i].popped) {
+                        matchIdx = i;
+                        break;
+                    }
+                }
+            } else {
+                for (int i = (int)stack.size() - 1; i >= 0; i--) {
+                    if (!stack[i].popped && stack[i].spOffset == disp) {
+                        matchIdx = i;
+                        break;
+                    }
+                }
+            }
+
+            if (matchIdx >= 0) {
+                auto &match = stack[matchIdx];
+                if (match.size == loadSize) {
+                    bool frozen = false;
+                    lookupMRP(loadPC, frozen);
+                    if (!frozen) {
+                        if (isPop) {
+                            match.popped = true;
+                            match.poppedSeqNum = seqNum;
+                        }
+                        Addr storePC = match.pushPC;
+                        auto mrtIt = mrtTable.find(storePC);
+                        if (mrtIt != mrtTable.end()) {
+                            auto &q = mrtIt->second;
+                            MRTEntry<RegIdType>* storeEntry = nullptr;
+                            for (int o = 0; o < q.count; o++) {
+                                MRTEntry<RegIdType>* e = q.getAtOffset(o);
+                                if (e && e->valid && e->seqNum < seqNum) {
+                                    storeEntry = e;
+                                    break;
+                                }
+                            }
+                            if (storeEntry) {
+                                outSpeculative = true;
+                                outData = storeEntry->data;
+                                outStPhysReg = storeEntry->st_physreg;
+                                outDataReady = storeEntry->dataReady;
+                                return true;
+                            }
+                        }
+                    }
+                }
+            }
+        }
+
+        // Try Dynamic match
+        if (enableDynamic) {
+            std::vector<uint32_t> indexEachWays(ways);
+            std::vector<uint32_t> tagEachWays(ways);
+            for (int i = 0; i < ways; i++) {
+                indexEachWays[i] = pcHashToWayIndex(loadPC, i);
+                tagEachWays[i] = pcHashToTag(loadPC, i);
+            }
+            for (int i = 0; i < ways; i++) {
+                auto &mrpEntry = mrpTable[i][indexEachWays[i]];
+                if (mrpEntry.valid && !compareTags(mrpEntry.tag, tagEachWays[i])) {
+                    mrpEntry.rrip = 0; // Reset RRIP on hit
+                    if (!mrpEntry.frozen && mrpEntry.confidence >= confidenceThreshold) {
+                        Addr storePC = mrpEntry.storePC;
+                        int offset = mrpEntry.offset;
+                        auto mrtIt = mrtTable.find(storePC);
+                        if (mrtIt != mrtTable.end()) {
+                            auto &q = mrtIt->second;
+                            MRTEntry<RegIdType>* storeEntry = q.getAtOffset(offset);
+                            if (storeEntry && storeEntry->size == loadSize && storeEntry->seqNum < seqNum) {
+                                outSpeculative = true;
+                                outData = storeEntry->data;
+                                outStPhysReg = storeEntry->st_physreg;
+                                outDataReady = storeEntry->dataReady;
+                                return true;
+                            }
+                        }
+                    }
+                }
+            }
+        }
+
+        return false;
+    }
+
+    void
+    updateMRTData(RegIdType physReg, Addr val)
+    {
+        for (auto &mrtPair : mrtTable) {
+            auto &q = mrtPair.second;
+            for (int i = 0; i < q.count; i++) {
+                MRTEntry<RegIdType> *entry = q.getAtOffset(i);
+                if (entry && entry->st_physreg == physReg && !entry->dataReady) {
+                    entry->data = val;
+                    entry->dataReady = true;
+                }
+            }
+        }
+    }
+
+    void
+    squash(ThreadID tid, uint64_t seq_no)
+    {
+        // Rollback active stores in MRT
+        int numSquashedStores = 0;
+        for (int i = (int)activeStoreList.size() - 1; i >= 0; i--) {
+            if (activeStoreList[i].tid == tid && activeStoreList[i].seqNum > seq_no) {
+                numSquashedStores++;
+                Addr storePC = activeStoreList[i].pc;
+                auto mrtIt = mrtTable.find(storePC);
+                if (mrtIt != mrtTable.end()) {
+                    mrtIt->second.rollback(1);
+                }
+            }
+        }
+        if (numSquashedStores > 0) {
+            activeStoreList.erase(activeStoreList.end() - numSquashedStores, activeStoreList.end());
+        }
+
+        // Truncate SRP-stack pushes
+        auto &stack = srpStacks[tid];
+        int numSquashedPushes = 0;
+        for (int i = (int)stack.size() - 1; i >= 0; i--) {
+            if (stack[i].seqNum > seq_no) {
+                numSquashedPushes++;
+            } else {
+                break;
+            }
+        }
+        if (numSquashedPushes > 0) {
+            stack.erase(stack.end() - numSquashedPushes, stack.end());
+        }
+
+        // Restore popped state on SRP-stack pops
+        for (auto &entry : stack) {
+            if (entry.popped && entry.poppedSeqNum > seq_no) {
+                entry.popped = false;
+                entry.poppedSeqNum = 0;
+            }
+        }
+    }
+};
+
+} // namespace valuepred
+
+} // namespace gem5
+
+#endif // __CPU_VALUEPRED_MEMORY_RENAMING_CORE_HH__
diff --git a/src/cpu/valuepred/memory_renaming_pipeline_harness.hh b/src/cpu/valuepred/memory_renaming_pipeline_harness.hh
new file mode 100644
index 0000000000..e9cd55e5de
--- /dev/null
+++ b/src/cpu/valuepred/memory_renaming_pipeline_harness.hh
@@ -0,0 +1,333 @@
+#ifndef __CPU_VALUEPRED_MEMORY_RENAMING_PIPELINE_HARNESS_HH__
+#define __CPU_VALUEPRED_MEMORY_RENAMING_PIPELINE_HARNESS_HH__
+
+/**
+ * Lightweight pipeline harnesses for Memory Renaming unit/integration tests.
+ *
+ * These classes mirror the rename- and commit-stage contracts implemented in
+ * memory_renaming.cc and commit.cc without requiring SimObject, DynInst, or
+ * CPU initialization. When the production hooks change, update the harness
+ * methods here once rather than duplicating logic across test files.
+ */
+
+#include <algorithm>
+#include <cstdint>
+#include <unordered_map>
+#include <vector>
+
+#include "cpu/valuepred/memory_renaming_core.hh"
+
+namespace gem5
+{
+
+namespace valuepred
+{
+
+namespace test
+{
+
+/** Default MemoryRenamingCore parameters used across the test suite. */
+inline MemoryRenamingCore<int> *
+createDefaultCore()
+{
+    return new MemoryRenamingCore<int>(
+        4,      // ways
+        1024,   // entryCounts (log2=10)
+        16,     // tagWidth
+        10,     // logESTBEntrys
+        2,      // logMaxConfidence (max=3)
+        2,      // confidenceThreshold
+        1,      // allocationConfidence
+        1,      // reallocationConfidence
+        1,      // demotionPenalty
+        8,      // mrtQueueCapacity
+        512,    // committedStoreQueueCapacity
+        true,   // enableDynamic
+        true,   // enableStatic
+        1       // numThreads
+    );
+}
+
+/**
+ * Simulates MemoryRenaming rename-stage hooks (renameStore, renameLoad,
+ * writebackReg, completeLoadLSU, squash) using integer physical register
+ * indices and an in-memory scoreboard.
+ */
+class RenamePipelineHarness
+{
+  public:
+    MemoryRenamingCore<int> core;
+    ThreadID tid = 0;
+
+    std::unordered_map<int, uint64_t> physRegs;
+    std::unordered_map<int, bool> scoreboard;
+
+    struct PendingLoad
+    {
+        InstSeqNum loadSeq = 0;
+        int ldPhysReg = -1;
+        uint64_t predictedVal = 0;
+        bool speculative = false;
+    };
+    std::unordered_map<int, std::vector<PendingLoad>> pendingLoads;
+
+    struct LoadPrediction
+    {
+        InstSeqNum loadSeq = 0;
+        int ldPhysReg = -1;
+        uint64_t predictedVal = 0;
+        bool speculative = false;
+    };
+    std::vector<LoadPrediction> renamePredictions;
+
+    explicit RenamePipelineHarness(MemoryRenamingCore<int> *c) : core(*c) {}
+
+    void setRegReady(int physReg, uint64_t val)
+    {
+        physRegs[physReg] = val;
+        scoreboard[physReg] = true;
+    }
+
+    void renameStore(Addr storePC, InstSeqNum seqNum, int stPhysReg,
+                     bool srcReady, uint64_t srcVal, uint8_t size = 8,
+                     bool trackSRP = false, int64_t spOffset = 0)
+    {
+        core.insertStore(storePC, seqNum, tid, size, stPhysReg, srcReady, srcVal);
+        if (trackSRP) {
+            core.pushSRP(tid, storePC, seqNum, size, spOffset, stPhysReg);
+        }
+    }
+
+    bool renameLoad(Addr loadPC, InstSeqNum seqNum, int ldPhysReg,
+                    uint8_t size = 8, bool isPop = false, bool isPeek = false,
+                    int64_t disp = 0)
+    {
+        bool speculative = false, ready = false;
+        Addr data = 0;
+        int stReg = 0;
+        bool hit = core.matchLoad(loadPC, size, tid, seqNum, isPop, isPeek, disp,
+                                  speculative, data, stReg, ready);
+        if (!hit) {
+            return false;
+        }
+        if (ready) {
+            physRegs[ldPhysReg] = data;
+            scoreboard[ldPhysReg] = true;
+            LoadPrediction pred;
+            pred.loadSeq = seqNum;
+            pred.ldPhysReg = ldPhysReg;
+            pred.predictedVal = data;
+            pred.speculative = true;
+            renamePredictions.push_back(pred);
+        } else {
+            PendingLoad pending;
+            pending.loadSeq = seqNum;
+            pending.ldPhysReg = ldPhysReg;
+            pending.speculative = true;
+            pendingLoads[stReg].push_back(pending);
+
+            LoadPrediction pred;
+            pred.loadSeq = seqNum;
+            pred.ldPhysReg = ldPhysReg;
+            pred.speculative = true;
+            renamePredictions.push_back(pred);
+        }
+        return true;
+    }
+
+    void writebackReg(int stPhysReg, uint64_t val)
+    {
+        core.updateMRTData(stPhysReg, val);
+        auto it = pendingLoads.find(stPhysReg);
+        if (it == pendingLoads.end()) {
+            return;
+        }
+        for (auto &load : it->second) {
+            load.predictedVal = val;
+            load.speculative = true;
+            physRegs[load.ldPhysReg] = val;
+            scoreboard[load.ldPhysReg] = true;
+            for (auto &pred : renamePredictions) {
+                if (pred.loadSeq == load.loadSeq) {
+                    pred.predictedVal = val;
+                }
+            }
+        }
+        pendingLoads.erase(it);
+    }
+
+    void completeLoadLSU(InstSeqNum loadSeq)
+    {
+        for (auto &pair : pendingLoads) {
+            auto &list = pair.second;
+            list.erase(
+                std::remove_if(list.begin(), list.end(),
+                               [loadSeq](const PendingLoad &l) {
+                                   return l.loadSeq == loadSeq;
+                               }),
+                list.end());
+        }
+    }
+
+    void squash(InstSeqNum squashSn)
+    {
+        core.squash(tid, squashSn);
+        for (auto &pair : pendingLoads) {
+            auto &list = pair.second;
+            list.erase(
+                std::remove_if(list.begin(), list.end(),
+                               [squashSn](const PendingLoad &l) {
+                                   return l.loadSeq > squashSn;
+                               }),
+                list.end());
+        }
+    }
+
+    /**
+     * Mirrors IEW bypassWriteback verification: compare LSU value against the
+     * predicted rename-time value for a load that was speculatively renamed.
+     */
+    bool verifyLoadWriteback(InstSeqNum loadSeq, int ldPhysReg,
+                             uint64_t actualVal, bool &misprediction)
+    {
+        misprediction = false;
+        for (const auto &pred : renamePredictions) {
+            if (pred.loadSeq == loadSeq) {
+                if (pred.speculative && pred.predictedVal != actualVal) {
+                    misprediction = true;
+                }
+                physRegs[ldPhysReg] = actualVal;
+                scoreboard[ldPhysReg] = true;
+                completeLoadLSU(loadSeq);
+                return true;
+            }
+        }
+        return false;
+    }
+
+    size_t pendingCount() const
+    {
+        size_t total = 0;
+        for (const auto &pair : pendingLoads) {
+            total += pair.second.size();
+        }
+        return total;
+    }
+};
+
+/**
+ * Simulates Commit-stage Memory Renaming hooks: store commit tracking,
+ * load retirement training (MemoryRenaming::update), VPcorrect accounting,
+ * and squash-after on value misprediction at the instruction boundary.
+ */
+class CommitPipelineHarness
+{
+  public:
+    MemoryRenamingCore<int> &core;
+    ThreadID tid = 0;
+
+    uint64_t vpCorrect = 0;
+
+    struct LoadCommitResult
+    {
+        bool trained = false;
+        bool demoted = false;
+        int producerOffset = -1;
+        bool squashPending = false;
+        bool squashTriggered = false;
+        InstSeqNum squashAfterSn = 0;
+    };
+
+    explicit CommitPipelineHarness(MemoryRenamingCore<int> &c) : core(c) {}
+
+    void commitStore(Addr pc, InstSeqNum seqNum, Addr physAddr = 0, uint8_t size = 0)
+    {
+        core.commitStore(pc, seqNum, physAddr, size);
+    }
+
+    /**
+     * Mirrors MemoryRenaming::update() plus commit.cc misprediction handling.
+     * Call finishInstBoundary() when the committing uop is on an instruction
+     * boundary to model squash-after.
+     */
+    LoadCommitResult commitLoad(Addr loadPC, InstSeqNum loadSeqNum,
+                                bool hasProducer, Addr storePC,
+                                InstSeqNum storeSeqNum,
+                                bool vpSpeculative, bool vpMisprediction,
+                                uint64_t predictedVal = 0,
+                                uint64_t actualVal = 0,
+                                Addr loadPhysAddr = 0,
+                                uint8_t loadSize = 0)
+    {
+        LoadCommitResult result;
+
+        if (hasProducer) {
+            result.producerOffset = core.getProducerOffset(storeSeqNum, storePC);
+            if (result.producerOffset >= 0) {
+                core.trainMRP(loadPC, storePC, result.producerOffset, true);
+                result.trained = true;
+            } else {
+                core.trainMRP(loadPC, 0, 0, false);
+                result.demoted = true;
+            }
+        } else {
+            auto match = core.findForwardingStore(loadPhysAddr, loadSize, loadSeqNum);
+            if (match.found) {
+                result.producerOffset =
+                    core.getProducerOffset(match.storeSeqNum, match.storePC);
+                if (result.producerOffset >= 0) {
+                    core.trainMRP(loadPC, match.storePC, result.producerOffset, true);
+                    result.trained = true;
+                } else {
+                    core.trainMRP(loadPC, 0, 0, false);
+                    result.demoted = true;
+                }
+            } else {
+                core.trainMRP(loadPC, 0, 0, false);
+                result.demoted = true;
+            }
+        }
+
+        core.retireSRP(tid, loadSeqNum);
+
+        if (vpSpeculative && !vpMisprediction) {
+            vpCorrect++;
+        }
+
+        if (vpMisprediction) {
+            valuePredictionSquash = true;
+            squashAfterSn = loadSeqNum;
+            result.squashPending = true;
+            result.squashAfterSn = loadSeqNum;
+        }
+
+        (void)predictedVal;
+        (void)actualVal;
+        return result;
+    }
+
+    /** Mirrors commit.cc squash-after at onInstBoundary. */
+    bool finishInstBoundary()
+    {
+        if (!valuePredictionSquash) {
+            return false;
+        }
+        lastSquashAfterSn = squashAfterSn;
+        valuePredictionSquash = false;
+        return true;
+    }
+
+    bool isSquashPending() const { return valuePredictionSquash; }
+    InstSeqNum getLastSquashAfterSn() const { return lastSquashAfterSn; }
+
+  private:
+    bool valuePredictionSquash = false;
+    InstSeqNum squashAfterSn = 0;
+    InstSeqNum lastSquashAfterSn = 0;
+};
+
+} // namespace test
+} // namespace valuepred
+} // namespace gem5
+
+#endif // __CPU_VALUEPRED_MEMORY_RENAMING_PIPELINE_HARNESS_HH__
