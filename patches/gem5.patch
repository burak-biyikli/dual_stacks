+// ============================================================================
+// 3. SRP-Stack LIFO & Peek Matching Tests
+// ============================================================================
+
+TEST_F(MemoryRenamingCoreTest, SRPStackLIFOAndPeek)
+{
+    auto core = createDefaultCore();
+    ThreadID tid = 0;
+
+    // Push two entries on stack
+    core->pushSRP(tid, 0x1000, 10, 8, -8, 5);  // Push 1: seq 10, offset -8, st_physreg 5, size 8
+    core->pushSRP(tid, 0x1100, 12, 8, -16, 6); // Push 2: seq 12, offset -16, st_physreg 6, size 8
+
+    // Test MRT state mapping
+    core->insertStore(0x1000, 10, tid, 8, 5, true, 0xDEADBEEF);
+    core->insertStore(0x1100, 12, tid, 8, 6, false, 0);
+
+    // 1. Pop match: should match the most recent (LIFO) -> Push 2
+    bool spec = false, ready = false;
+    Addr data = 0;
+    int stReg = 0;
+    bool hit = core->matchLoad(0x3000, 8, tid, 15, true, false, 0, spec, data, stReg, ready);
+    EXPECT_TRUE(hit);
+    EXPECT_TRUE(spec);
+    EXPECT_EQ(stReg, 6);
+    EXPECT_FALSE(ready);
+
+    // Verify it is marked popped
+    EXPECT_TRUE(core->srpStacks[tid][1].popped);
+    EXPECT_EQ(core->srpStacks[tid][1].poppedSeqNum, 15);
+
+    // 2. Next Pop match: should match Push 1 (since Push 2 is popped)
+    hit = core->matchLoad(0x3008, 8, tid, 16, true, false, 0, spec, data, stReg, ready);
+    EXPECT_TRUE(hit);
+    EXPECT_TRUE(spec);
+    EXPECT_EQ(stReg, 5);
+    EXPECT_TRUE(ready);
+    EXPECT_EQ(data, 0xDEADBEEF);
+    EXPECT_TRUE(core->srpStacks[tid][0].popped);
+
+    // 3. Push a new stack entry for Peek matching
+    core->pushSRP(tid, 0x1200, 20, 4, -24, 7);
+    core->insertStore(0x1200, 20, tid, 4, 7, true, 0xCAFEBABE);
+
+    // Peek match at offset -24: should match but NOT mark popped
+    hit = core->matchLoad(0x3010, 4, tid, 25, false, true, -24, spec, data, stReg, ready);
+    EXPECT_TRUE(hit);
+    EXPECT_TRUE(spec);
+    EXPECT_EQ(stReg, 7);
+    EXPECT_EQ(data, 0xCAFEBABE);
+    EXPECT_FALSE(core->srpStacks[tid][2].popped); // remains unpopped!
+
+    // Peek match with size mismatch: should be suppressed
+    hit = core->matchLoad(0x3010, 8, tid, 25, false, true, -24, spec, data, stReg, ready);
+    EXPECT_FALSE(hit);
+
+    delete core;
+}
