+    core->insertStore(storePC, 12, tid, 8, 6, true, 0x12);
+
+    core->pushSRP(tid, storePC, 15, 8, -24, 7);
+    core->insertStore(storePC, 15, tid, 8, 7, true, 0x15);
+
+    // Pop the 3rd store (seq 15) with a load at seq 18
+    bool spec = false, ready = false;
+    Addr data = 0;
+    int stReg = 0;
+    bool hit = core->matchLoad(0x3000, 8, tid, 18, true, false, 0, spec, data, stReg, ready);
+    EXPECT_TRUE(hit);
+    EXPECT_EQ(stReg, 7);
+    EXPECT_TRUE(core->srpStacks[tid][2].popped);
+
+    // Squash everything younger than sequence number 13 (so seq 15 is squashed)
+    core->squash(tid, 13);
+
+    // 1. Check MRT rolled back properly (seq 15 store removed)
+    auto &q = core->mrtTable[storePC];
+    EXPECT_EQ(q.count, 2);
+    EXPECT_EQ(q.getAtOffset(0)->seqNum, 12);
+
+    // 2. Check SRP stack rolled back (seq 15 push removed)
+    EXPECT_EQ(core->srpStacks[tid].size(), 2);
+
+    // 3. Squash everything younger than sequence number 11 (so seq 12 pop/load is squashed)
+    // First, let's simulate pop of seq 12 (Push 2) at seq 14
+    core->srpStacks[tid][1].popped = true;
+    core->srpStacks[tid][1].poppedSeqNum = 14;
+
+    // Now squash seq 14 by squashing younger than 13
+    core->squash(tid, 13);
+
+    // The popped state should be restored to false
+    EXPECT_FALSE(core->srpStacks[tid][1].popped);
+
+    delete core;
+}
