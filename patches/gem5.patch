+#include <gtest/gtest.h>
+
+#include "cpu/valuepred/memory_renaming_pipeline_harness.hh"
+
+using namespace gem5;
+using namespace gem5::valuepred;
+using namespace gem5::valuepred::test;
+
+class RenamePipelineTest : public ::testing::Test
+{
+  protected:
+    MemoryRenamingCore<int> *core = nullptr;
+
+    void SetUp() override { core = createDefaultCore(); }
+    void TearDown() override { delete core; core = nullptr; }
+};
+
+TEST_F(RenamePipelineTest, CaseAImmediateInjection)
+{
+    RenamePipelineHarness harness(core);
+
+    Addr storePC = 0x1000;
+    Addr loadPC = 0x1500;
+
+    harness.renameStore(storePC, 10, 5, true, 0xCAFE);
+    harness.core.trainMRP(loadPC, storePC, 0, true);
+    harness.core.trainMRP(loadPC, storePC, 0, true);
+
+    EXPECT_TRUE(harness.renameLoad(loadPC, 12, 8));
+    EXPECT_TRUE(harness.scoreboard[8]);
+    EXPECT_EQ(harness.physRegs[8], 0xCAFE);
+}
+
+TEST_F(RenamePipelineTest, CaseBPendingWriteback)
+{
+    RenamePipelineHarness harness(core);
+
+    Addr storePC = 0x1000;
+    Addr loadPC = 0x1500;
+
+    harness.renameStore(storePC, 10, 5, false, 0);
+    harness.core.trainMRP(loadPC, storePC, 0, true);
+    harness.core.trainMRP(loadPC, storePC, 0, true);
+
+    EXPECT_TRUE(harness.renameLoad(loadPC, 12, 8));
+    EXPECT_FALSE(harness.scoreboard[8]);
+    EXPECT_EQ(harness.pendingCount(), 1u);
+
+    harness.writebackReg(5, 0x12345678);
+    EXPECT_EQ(harness.pendingCount(), 0u);
+    EXPECT_TRUE(harness.scoreboard[8]);
+    EXPECT_EQ(harness.physRegs[8], 0x12345678);
+}
+
+TEST_F(RenamePipelineTest, MultiplePendingLoads)
+{
+    RenamePipelineHarness harness(core);
+
+    Addr storePC = 0x1000;
+    Addr loadPC1 = 0x1500;
+    Addr loadPC2 = 0x1600;
+
+    harness.renameStore(storePC, 10, 5, false, 0);
+    harness.core.trainMRP(loadPC1, storePC, 0, true);
+    harness.core.trainMRP(loadPC1, storePC, 0, true);
+    harness.core.trainMRP(loadPC2, storePC, 0, true);
+    harness.core.trainMRP(loadPC2, storePC, 0, true);
+
+    EXPECT_TRUE(harness.renameLoad(loadPC1, 12, 8));
+    EXPECT_TRUE(harness.renameLoad(loadPC2, 13, 9));
+    EXPECT_EQ(harness.pendingCount(), 2u);
+
+    harness.writebackReg(5, 0xABCDEF00);
+    EXPECT_EQ(harness.pendingCount(), 0u);
+    EXPECT_EQ(harness.physRegs[8], 0xABCDEF00);
+    EXPECT_EQ(harness.physRegs[9], 0xABCDEF00);
+}
+
+TEST_F(RenamePipelineTest, LSUCompletionRace)
+{
+    RenamePipelineHarness harness(core);
+
+    Addr storePC = 0x1000;
+    Addr loadPC = 0x1500;
+
+    harness.renameStore(storePC, 10, 5, false, 0);
+    harness.core.trainMRP(loadPC, storePC, 0, true);
+    harness.core.trainMRP(loadPC, storePC, 0, true);
+    EXPECT_TRUE(harness.renameLoad(loadPC, 12, 8));
+    EXPECT_EQ(harness.pendingCount(), 1u);
+
+    harness.physRegs[8] = 0x99998888;
+    harness.scoreboard[8] = true;
+    harness.completeLoadLSU(12);
+    EXPECT_EQ(harness.pendingCount(), 0u);
+
+    harness.writebackReg(5, 0x11112222);
+    EXPECT_EQ(harness.physRegs[8], 0x99998888);
+}
+
+TEST_F(RenamePipelineTest, SquashCleansPendingAndTables)
+{
+    RenamePipelineHarness harness(core);
+
+    harness.renameStore(0x1000, 10, 5, false, 0, 8, true, -8);
+    harness.renameStore(0x1100, 15, 6, false, 0, 8, true, -16);
+    harness.core.trainMRP(0x2000, 0x1100, 0, true);
+    harness.core.trainMRP(0x2000, 0x1100, 0, true);
+    EXPECT_TRUE(harness.renameLoad(0x2000, 18, 8, 8, true));
+
+    EXPECT_EQ(harness.pendingCount(), 1u);
+    EXPECT_EQ(harness.core.srpStacks[0].size(), 2u);
+
+    harness.squash(13);
+    EXPECT_EQ(harness.pendingCount(), 0u);
+    EXPECT_EQ(harness.core.srpStacks[0].size(), 1u);
+    EXPECT_EQ(harness.core.mrtTable[0x1100].count, 0);
+}
+
+TEST_F(RenamePipelineTest, SRPStaticPath)
+{
+    RenamePipelineHarness harness(core);
+
+    harness.renameStore(0x1000, 10, 5, true, 0x42, 8, true, -8);
+    EXPECT_TRUE(harness.renameLoad(0x2000, 15, 8, 8, true));
+    EXPECT_EQ(harness.physRegs[8], 0x42);
+}
+
+TEST_F(RenamePipelineTest, WritebackVerificationMisprediction)
+{
+    RenamePipelineHarness harness(core);
+
+    Addr storePC = 0x1000;
+    Addr loadPC = 0x1500;
+
+    harness.renameStore(storePC, 10, 5, false, 0);
+    harness.core.trainMRP(loadPC, storePC, 0, true);
+    harness.core.trainMRP(loadPC, storePC, 0, true);
+    EXPECT_TRUE(harness.renameLoad(loadPC, 12, 8));
+
+    harness.writebackReg(5, 0xBAD);
+    EXPECT_EQ(harness.physRegs[8], 0xBAD);
+
+    bool mispred = false;
+    harness.verifyLoadWriteback(12, 8, 0x600D, mispred);
+    EXPECT_TRUE(mispred);
+    EXPECT_EQ(harness.physRegs[8], 0x600D);
+}
+
+TEST_F(RenamePipelineTest, RenameCommitIntegration)
+{
+    RenamePipelineHarness rename(core);
+    CommitPipelineHarness commit(rename.core);
+
+    Addr storePC = 0x1000;
+    Addr loadPC = 0x1500;
+
+    rename.renameStore(storePC, 10, 5, true, 0xCAFE);
+    rename.core.trainMRP(loadPC, storePC, 0, true);
+    rename.core.trainMRP(loadPC, storePC, 0, true);
+    EXPECT_TRUE(rename.renameLoad(loadPC, 12, 8));
+
+    commit.commitStore(storePC, 10);
+    auto result = commit.commitLoad(loadPC, 12, true, storePC, 10,
+                                    true, false);
+    EXPECT_TRUE(result.trained);
+    EXPECT_EQ(result.producerOffset, 0);
+    EXPECT_EQ(commit.vpCorrect, 1u);
+}
